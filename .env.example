# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2

# AWS S3 Configuration
AWS_S3_BUCKET_NAME=your-pdf-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_PRESIGNED_URL_EXPIRY=3600

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-long
JWT_ACCESS_TOKEN_EXPIRES=86400

# Master User Credentials
MASTER_USERNAME=admin
MASTER_PASSWORD=change-this-strong-password

# Database Configuration
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=strong-password-here
POSTGRES_DB=pdf_toolkit
POSTGRES_HOST=postgres
SQLALCHEMY_ECHO=False

# ClickHouse / Vector Logging (optional)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default
CLICKHOUSE_ENDPOINT=https://your-clickhouse-instance.com

# Limits
MAX_DOWNLOADS_PER_JOB=1000
MAX_DOWNLOAD_SIZE_MB=1024
MAX_QUEUED_REQUESTS=1000

# Application
ENV=production
LOG_LEVEL=INFO
FLASK_DEBUG=0

# UnoServer
UNOSERVER_HOST=unoserver
UNOSERVER_PORT=2003
UNO_SERVER_TIMEOUT=60

# PDF Compression
PDF_USE_LOSSLESS_COMPRESSION=false
PDF_JPEG_QUALITY=80
PDF_REDUCE_IMAGE_RESOLUTION=true
PDF_MAX_IMAGE_RESOLUTION=150

# Template Cache
TEMPLATE_CACHE_ENABLED=true
TEMPLATE_CACHE_DIR=/app/template_cache
TEMPLATE_CACHE_MAX_SIZE_MB=500
TEMPLATE_CACHE_TTL_DAYS=7
